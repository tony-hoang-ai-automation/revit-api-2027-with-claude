<Window x:Class="MyRevitAIApp.ColumnRebarViewer.Views.ColumnRebarViewerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyRevitAIApp.ColumnRebarViewer.ViewModels"
        xmlns:local="clr-namespace:MyRevitAIApp.ColumnRebarViewer.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ColumnRebarViewerViewModel}"
        Title="Tạo New PF — Vẽ thép cột"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvB2V"/>
        <local:InverseBoolConverter x:Key="InvBool"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main body: INPUT (left) + CANVAS area (right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Input panel ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>

                    <!-- Tiết diện cột (read-only from Revit) -->
                    <GroupBox Header="Tiết diện cột (từ Revit)" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="b (mm):" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SectionB, StringFormat=F0}"
                                       IsReadOnly="True" Background="#F0F0F0" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="h (mm):" Style="{StaticResource FieldLabel}" Margin="8,0,8,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding SectionH, StringFormat=F0}"
                                       IsReadOnly="True" Background="#F0F0F0" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="H cột:" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Text="{Binding ColumnHeight, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Thép dọc chủ -->
                    <GroupBox Header="Thép dọc chủ" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Đường kính (mm):" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding LongBarDiameters}"
                                      SelectedItem="{Binding LongBarDiameter}"
                                      Padding="4,2" Margin="0,0,0,4"/>

                            <TextBlock Text="Kiểu bố trí:" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding Layouts}"
                                      SelectedItem="{Binding SelectedLayout}"
                                      Padding="4,2" Margin="0,0,0,4"/>

                            <!-- ByPerimeter mode -->
                            <StackPanel Visibility="{Binding IsSidesBased, Converter={StaticResource InvB2V}}">
                                <TextBlock Text="Tổng số thanh (n ≥ 4):" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LongBarCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"/>
                            </StackPanel>

                            <!-- BySides mode -->
                            <StackPanel Visibility="{Binding IsSidesBased, Converter={StaticResource B2V}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Theo cạnh b:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding BarsAlongB, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Theo cạnh h:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding BarsAlongH, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Thép đai -->
                    <GroupBox Header="Thép đai" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Đường kính đai (mm):" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding StirrupDiameters}"
                                      SelectedItem="{Binding StirrupDiameter}"
                                      Padding="4,2" Margin="0,0,0,4"/>

                            <CheckBox Content="Tự tính vùng gia cường (TCVN 5574)"
                                      IsChecked="{Binding AutoTcvn}"
                                      Margin="0,4,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Đai vùng giữa:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding StirrupSpacing, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding AutoTcvn, Converter={StaticResource InvBool}}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Đai gia cường:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ConfinementSpacing, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding AutoTcvn, Converter={StaticResource InvBool}}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Chiều dài vùng gia cường (mm):" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ConfinementLength, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding AutoTcvn, Converter={StaticResource InvBool}}"
                                     Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Lớp bảo vệ + vật liệu -->
                    <GroupBox Header="Lớp bảo vệ + Vật liệu" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cover (mm):" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="0" Margin="0,0,4,4"
                                       Text="{Binding CoverMm, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Nhóm thép:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1"
                                       ItemsSource="{Binding SteelGroups}"
                                       SelectedItem="{Binding SelectedSteel}"
                                       Padding="4,2" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Cấp bê tông:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       ItemsSource="{Binding ConcreteGrades}"
                                       SelectedItem="{Binding SelectedConcrete}"
                                       Padding="4,2" Margin="0,0,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- Neo / nối thép -->
                    <GroupBox Header="Chiều dài neo / nối thép (mm)" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Lneo:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LneoMm, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Lnối:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LnoiMm, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ RIGHT: Canvas area ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar zoom -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="BtnZoomIn"  Content="+ Zoom" Style="{StaticResource ToolBtn}" Click="BtnZoomIn_Click"/>
                    <Button x:Name="BtnZoomOut" Content="- Zoom" Style="{StaticResource ToolBtn}" Click="BtnZoomOut_Click"/>
                    <Button x:Name="BtnFit"     Content="Fit"    Style="{StaticResource ToolBtn}" Click="BtnFit_Click"/>
                    <TextBlock Text="  Kéo để pan  |  Cuộn chuột để zoom"
                               VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="8,0"/>
                </StackPanel>

                <!-- Two canvases side by side -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Mặt cắt ngang  (click thanh thép để thêm/bỏ đai phụ chữ C)" Margin="0,0,4,0">
                        <local:RebarCanvas x:Name="SectionCanvas"
                                           RenderMode="Section"
                                           SectionModel="{Binding Section}"
                                           BarClickedCommand="{Binding ToggleCrossTieCommand}"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Mặt đứng" Margin="4,0,0,0">
                        <local:RebarCanvas x:Name="ElevationCanvas"
                                           RenderMode="Elevation"
                                           ElevationModel="{Binding Elevation}"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ Bottom bar ═══ -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Luu cau hinh"
                    Command="{Binding SaveConfigCommand}"
                    Padding="14,6" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Tai cau hinh"
                    Command="{Binding LoadConfigCommand}"
                    Padding="14,6" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Content="Tao thep vao model"
                    Command="{Binding CreateRebarCommand}"
                    Padding="14,6"
                    FontWeight="SemiBold"
                    Background="#2E7D32" Foreground="White"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="16,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="DarkSlateGray"
                       FontSize="11"/>

            <Button Grid.Column="4" Content="Dong"
                    IsCancel="True" Padding="24,6" MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
