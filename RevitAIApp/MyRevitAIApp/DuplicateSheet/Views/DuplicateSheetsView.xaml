<Window x:Class="MyRevitAIApp.DuplicateSheet.Views.DuplicateSheetsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MyRevitAIApp.DuplicateSheet.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DuplicateSheetsViewModel}"
        Title="Duplicate Sheets"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar: search + count -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     ToolTip="Filter by sheet number or name"/>
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Sheets.Count, StringFormat=Total: {0}}"/>
        </Grid>

        <!-- Main: sheet list (left) + options (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding SheetsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="26">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="*"   IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Right options panel -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Naming Rule" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Sheet Number" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Prefix"            Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Suffix"            Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding NumberSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Find"              Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding NumberFind, UpdateSourceTrigger=PropertyChanged}"   Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Replace"           Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding NumberReplace, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Increment start"   Style="{StaticResource FieldLabel}" ToolTip="0 = disabled"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding NumberIncrementStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Increment pad"     Style="{StaticResource FieldLabel}" ToolTip="Zero-padding length"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding NumberIncrementPad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Sheet Name" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="8"  Grid.Column="0" Text="Prefix"   Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="8"  Grid.Column="1" Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="9"  Grid.Column="0" Text="Suffix"   Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="9"  Grid.Column="1" Text="{Binding NameSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Find"     Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding NameFind, UpdateSourceTrigger=PropertyChanged}"   Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Replace"  Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding NameReplace, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="View Duplicate Mode" Padding="8" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" Padding="4,2"/>
                    </GroupBox>

                    <GroupBox Header="Include in new sheet" Padding="8">
                        <StackPanel>
                            <CheckBox Content="Title block (align position)" IsChecked="{Binding CopyTitleBlock}" Margin="0,2"/>
                            <CheckBox Content="Legends (placed reference)"   IsChecked="{Binding IncludeLegends}" Margin="0,2"/>
                            <CheckBox Content="Schedules"                    IsChecked="{Binding IncludeSchedules}" Margin="0,2"/>
                            <CheckBox Content="Sheet-level annotations"      IsChecked="{Binding CopySheetAnnotations}" Margin="0,2"
                                      ToolTip="Text notes, dimensions, detail lines, filled regions, revision clouds placed directly on the sheet"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Preview -->
        <GroupBox Grid.Row="2" Header="Preview" Margin="0,8,0,8" Padding="4">
            <DataGrid ItemsSource="{Binding PreviewItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source #"   Binding="{Binding SourceNumber}" Width="100"/>
                    <DataGridTextColumn Header="Source Name" Binding="{Binding SourceName}" Width="*"/>
                    <DataGridTextColumn Header="New #"      Binding="{Binding NewNumber}"   Width="120"/>
                    <DataGridTextColumn Header="New Name"   Binding="{Binding NewName}"     Width="*"/>
                    <DataGridTextColumn Header="Status"     Binding="{Binding StatusMessage}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Bottom bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Refresh Preview"
                    Command="{Binding RefreshPreviewCommand}"
                    Padding="12,6"
                    MinWidth="140"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="16,0"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel"  IsCancel="True"  Padding="20,6" MinWidth="100" Margin="0,0,8,0"/>
                <Button Content="Execute" Command="{Binding ExecuteCommand}" IsDefault="True" Padding="20,6" MinWidth="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
